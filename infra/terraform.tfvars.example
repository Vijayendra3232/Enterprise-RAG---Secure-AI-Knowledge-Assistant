# Example Terraform variables (DO NOT commit plaintext secrets to Git)
aws_region          = "us-east-1"
environment         = "production"
project_name        = "enterprise-rag"
domain_name         = "api.rag.enterprise.internal"
vpc_cidr            = "10.0.0.0/16"
availability_zones  = ["us-east-1a", "us-east-1b"]
container_image     = "123456789012.dkr.ecr.us-east-1.amazonaws.com/enterprise-rag:v1.0.0"

# OpenSearch HA Topology (2 Data Nodes across 2 AZs + 3 Dedicated Masters)
opensearch_instance_type          = "r6g.large.search"
opensearch_instance_count         = 2
opensearch_dedicated_master_count = 3
opensearch_dedicated_master_type  = "m6g.large.search"
opensearch_volume_size_gb         = 100

# RDS PostgreSQL Multi-AZ
db_instance_class       = "db.r6g.xlarge"
db_allocated_storage_gb = 100

# ECS Fargate Baseline Tasks
api_min_tasks    = 2
api_max_tasks    = 10
worker_min_tasks = 2
worker_max_tasks = 10
